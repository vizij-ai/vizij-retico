...@_brand.d2

# Fig 0 — the compact version of Fig 4. Same silhouette, same colour semantics, so the
# two read as one family: four bands, capture → retico → bridge → face. Every IU type,
# module name and event name is left to Fig 4.
#
# Edges connect band to band, never to a child inside another band — wiring into
# children makes dagre scatter the groups and the top-to-bottom read is lost.

direction: down

(** -> **)[*].style.stroke: "#555555"

cap: Browser · capture {
  class: group
  style.font-size: 18
  direction: right
  mic: Microphone\n16 kHz PCM { class: neutral }
  stt: Browser transcript\nWeb Speech { class: emphasis }
}

retico: Incremental dialogue · retico {
  class: group
  style.font-size: 18
  direction: right
  percept: Turn-taking · backchannel · nod\nVAP, ~10 Hz while you speak { class: primary }
  asr: ASR\nbrowser or local Whisper { class: primary }
  dialog: Streaming dialogue\nLLM → affect → TTS { class: primary }
}

bridge: One WebSocket protocol\nADD / REVOKE / COMMIT preserved end to end { class: secondary; style.font-size: 18 }

face: Vizij face · WASM rig in the browser {
  class: group
  style.font-size: 18
  direction: right
  gaze: gaze + blink { class: neutral }
  head: head nods { class: neutral }
  emo: expression { class: neutral }
  mouth: lip-sync { class: neutral }
}

cap -> retico: audio, continuously\nplus the browser transcript
retico -> bridge: every signal, as it firms up
bridge -> face
face -> cap: responds DURING your turn,\nnot after it { style: { stroke: "#EC4D00"; stroke-width: 3; font-color: "#EC4D00"; font-size: 18 } }

swap: every stage swaps models at runtime — local or cloud { class: highlight; style.font-size: 15; near: bottom-center }
